{
  "name": "sman6-garut-pjok",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.postgres.prisma && next dev",
    "build": "prisma generate --schema=prisma/schema.postgres.prisma && next build",
    "db:deploy": "prisma migrate deploy --config=prisma.postgres.config.ts",
    "db:import-sqlite": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.postgres.prisma && tsx prisma/migrate-sqlite-to-postgres.ts",
    "vercel-build": "npm run db:deploy && npm run build",
    "start": "next start",
    "seed": "tsx prisma/seed.ts",
    "import:siswa": "tsx prisma/import-siswa.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "2.118.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "16.6.1",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
